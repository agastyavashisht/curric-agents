# Copy this file to .env and fill in real values. Never commit .env itself.

# Provider: "gemini" or "groq" (GPT-4o / Claude are optional and not required)
MODEL_PROVIDER=gemini

GEMINI_API_KEY=AIza...
# Stable Gemini Flash (free tier available). Override if your key uses another ID.
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=gsk_...
# Groq retired llama3-70b-8192 and llama-3.3-70b-versatile on free/dev tiers.
GROQ_MODEL=openai/gpt-oss-120b

# Optional paid providers (not used for the pilot)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

DB_PATH=results/learner_state.db
LOG_PATH=logs/agent_calls.jsonl
CONTENT_LOG_PATH=results/generated_content.jsonl
