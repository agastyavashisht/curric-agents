# Copy this file to .env and fill in your real values.
# NEVER commit .env itself — it is listed in .gitignore.

# ── LLM provider ─────────────────────────────────────────────────────────────
# Recommended: "groq" (14,400 free requests/day — best for pilot)
# Alternative: "gemini" (only 20 req/day on gemini-3.6-flash — too low for pilot)
MODEL_PROVIDER=groq

GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (backup only — strict daily limit)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash

# Optional paid providers (not used for the free pilot)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Database paths ────────────────────────────────────────────────────────────
DB_PATH=results/learner_state.db
LOG_PATH=logs/agent_calls.jsonl
CONTENT_LOG_PATH=results/generated_content.jsonl

# Pilot study settings
PILOT_DOMAIN=python_programming   # Lock all students to one domain (leave blank for free choice)
PILOT_MAX_TOPICS=4                # Topics per session for students
PILOT_QPT=3                       # Questions per topic for students
ABLATION_MODE=full                # full | no_adaptive_assessment | no_adaptive_planning | planner_only | static
RESEARCHER_PASSWORD=changeme      # Password for researcher admin panel in the login page

# ── Supabase (online database — required for multi-machine pilot) ─────────────
# 1. Create free project at https://supabase.com
# 2. Run src/supabase_schema.sql in Supabase SQL Editor
# 3. Get URL from: Settings → API → Project URL
# 4. Get anon key from: Settings → API → anon/public key (starts with eyJ...)
# When both are set, all student data syncs to Supabase automatically.
# If not set, data is stored locally in DB_PATH only.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
