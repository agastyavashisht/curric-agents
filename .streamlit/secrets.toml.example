# ── Streamlit Cloud secrets ────────────────────────────────────────────────
# Copy this file's contents into:
#   Streamlit Cloud → Your app → Settings → Secrets
# (Do NOT commit this file with real values)

# LLM provider
MODEL_PROVIDER = "groq"
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-120b"

# Gemini backup
GEMINI_API_KEY = "AIza..."
GEMINI_MODEL = "gemini-3.6-flash"

# Database (SQLite on cloud = /tmp, but Supabase is the real store)
DB_PATH = "/tmp/learner_state.db"

# Supabase — REQUIRED for cloud deployment (SQLite is ephemeral on Streamlit Cloud)
SUPABASE_URL = "https://zmhadthvmuxkivxeehvz.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."

# Pilot settings
PILOT_DOMAIN = "python_programming"
PILOT_MAX_TOPICS = "4"
PILOT_QPT = "3"
ABLATION_MODE = "full"
RESEARCHER_PASSWORD = "changeme"
